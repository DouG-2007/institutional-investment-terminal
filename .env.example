# ==============================================================================
# Institutional Multi-Asset Investment Terminal (360° Engine) - Environment Config
# Copy this file to `.env` (which is gitignored) and fill in your key if you
# want to enable optional Gemini / Antigravity AI features.
# Deterministic Tabs 1-4 and Vector PDF export remain 100% operational without it.
# ==============================================================================

# Required only for AI features (Tab 3 Auto-Fetch Dossier, Tab 1 PDF Synthesis,
# Tab 4 AI Morning Briefing, and Tab 5 Read-Only AI Portfolio Analyst):
GEMINI_API_KEY=

# Optional model overrides (defaults shown):
# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# ANTIGRAVITY_MODEL=
